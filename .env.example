# Demo mode provides the demo accounts listed in README.md and sample reports.
DEMO_MODE=true
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-secret-before-deployment

# Used to bootstrap the first supervisor/worker when DEMO_MODE=false.
SUPERVISOR_NAME=Safety Supervisor
SUPERVISOR_EMAIL=supervisor@yourmine.example
SUPERVISOR_PASSWORD=ChangeThisSupervisorPassword!
WORKER_NAME=Mine Worker
WORKER_EMAIL=worker@yourmine.example
WORKER_PASSWORD=ChangeThisWorkerPassword!

# Firebase Firestore (optional locally, required for permanent data on Render).
# Paste the service-account JSON as ONE line, or use the BASE64 variant below (recommended on Render).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=
